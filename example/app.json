{
  "expo": {
    "name": "@tracked/health example",
    "slug": "tracked-health-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trckd.health.example",
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "We read the health categories you choose, including menstrual-cycle data, to keep your private health history in sync.",
        "NSHealthUpdateUsageDescription": "We do not write menstrual-cycle data; existing step and weight integrations may use HealthKit as described in the app.",
        "UIBackgroundModes": ["processing"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.trckd.health.example",
      "minSdkVersion": 26,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
